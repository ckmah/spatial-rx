{
  "name": "spatial-rx-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "SPATIAL_RX_BUILD_WIDGET=gallery vite build && SPATIAL_RX_BUILD_WIDGET=landmarks vite build",
    "watch": "SPATIAL_RX_BUILD_WIDGET=landmarks vite build --watch",
    "watch:gallery": "SPATIAL_RX_BUILD_WIDGET=gallery vite build --watch",
    "watch:landmarks": "SPATIAL_RX_BUILD_WIDGET=landmarks vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
