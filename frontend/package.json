{
  "name": "spatial-rx-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "SPATIAL_RX_BUILD_WIDGET=gallery vite build && SPATIAL_RX_BUILD_WIDGET=landmarks vite build && SPATIAL_RX_BUILD_WIDGET=polyrender vite build",
    "dev:landmarks": "vite",
    "dev:fixture": "uv run --directory .. python frontend/dev/export-fixture.py",
    "watch": "SPATIAL_RX_BUILD_WIDGET=landmarks vite build --watch",
    "watch:gallery": "SPATIAL_RX_BUILD_WIDGET=gallery vite build --watch",
    "watch:landmarks": "SPATIAL_RX_BUILD_WIDGET=landmarks vite build --watch",
    "watch:polyrender": "SPATIAL_RX_BUILD_WIDGET=polyrender vite build --watch",
    "merge-css": "node scripts/merge-widget-css.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:mac": "PLAYWRIGHT_CHANNEL=chrome playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@deck.gl/core": "9.1.14",
    "@deck.gl/extensions": "^9.1.14",
    "@deck.gl/layers": "9.1.14",
    "@deck.gl/widgets": "9.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.160.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
